{
	"name": "lantern",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"dependencies": {
		"@inertiajs/vue3": "^2.2.15",
		"tailwindcss": "^4.1.17",
		"vue": "^3.5.24"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.1.17",
		"@types/bun": "latest",
		"@vitejs/plugin-vue": "^6.0.1",
		"concurrently": "^9.2.1",
		"vite": "^7.2.2"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"scripts": {
		"serve": "bun --hot --watch run lantern.ts",
		"start": "npx concurrently -c \"#eb4034,#9534eb\" \"bun run serve\" \"bun run dev\" --names=server,vite --kill-others",
		"dev": "bunx --bun vite",
		"build": "bunx --bun vite build",
		"test": "bun test",
		"lint": "bunx eslint . --fix"
	}
}
