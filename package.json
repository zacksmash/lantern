{
	"name": "lantern",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"dependencies": {
		"@inertiajs/vue3": "^2.2.15",
		"tailwindcss": "^4.1.17",
		"vue": "^3.5.24"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@tailwindcss/vite": "^4.1.17",
		"@types/bun": "latest",
		"@vitejs/plugin-vue": "^6.0.1",
		"concurrently": "^9.2.1",
		"prettier": "3.6.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.7.1",
		"vite": "^7.2.2",
		"vue-tsc": "^3.1.3"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"scripts": {
		"serve": "bun --hot --inspect --watch run server.ts",
		"start": "npx concurrently -c \"#eb4034,#9534eb\" \"bun run serve\" \"bun run dev\" --names=server,vite --kill-others",
		"dev": "bunx --bun vite",
		"build": "bunx --bun vite build",
		"test": "bun test",
		"lint_check": "bunx biome check",
		"lint_server": "bunx biome check --write",
		"lint_client": "bunx prettier --write .",
		"lint": "bun run lint_server && bun run lint_client"
	}
}
